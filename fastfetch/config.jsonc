{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 2,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": "    ",
    "color": {
      "separator": "90"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "36", 
        "at": "90",
        "host": "36"  
      }
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "36"
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "36"
    },
    {
      "type": "packages",
      "key": "󰏖 ",
      "keyColor": "36"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "36"
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "36"
    },
    {
      "type": "memory",
      "key": "󰍛 ",
      "keyColor": "36"
    },
    {
      "type": "uptime",
      "key": "󰅐 ",
      "keyColor": "36"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break"
  ]
}
