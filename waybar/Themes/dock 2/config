{
    "layer": "top",
    "position": "top",
    "height": 28,
    "margin-top": 6,
    "margin-left": 120,
    "margin-right": 120,
    "spacing": 8,

    "modules-left": [
        "clock",
        "mpd"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "cava",
        "pulseaudio",
        "network",
        "battery"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "active-only": false,
        "on-click": "activate",
        "persistent-workspaces": {
            "1": [], "2": [], "3": [], "4": [], "5": []
        },
        "format": "{icon}",
        "format-icons": {
            "default": "",
            "active": "",
            "empty": ""
        }
    },
    
    "clock": {
        "format": "  {:%I:%M %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "mpd": {
        "format": "{stateIcon} Track: {title}  {artist}",
        "format-disconnected": " Offline",
        "format-stopped": " Stopped",
        "max-length": 45,
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },

    "cava": {
        "framerate": 60,
        "autosens": 0,
        "sensitivity": 1,
        "bars": 10,
        "lower_cutoff_freq": 50,
        "higher_cutoff_freq": 10000,
        "method": "pulse",
        "source": "auto",
        "stereo": true,
        "bar_delimiter": 0,
        "noise_reduction": 0.2,
        "input_delay": 2,
        "format-icons": [" ", "⡀", "⣀", "⣄", "⣤", "⣦", "⣶", "⣷", "⣿"]
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": "󰈀  LAN",
        "format-disconnected": "⚠",
        "tooltip-format": "{essid}"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    }
}
