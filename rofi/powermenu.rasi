@import "colors.rasi"

configuration {
    show-icons: false;
}

window {
    width: 400px;
    border-radius: 16px;
    border: 2px solid;
    border-color: @selected;
    background-color: @background;
    padding: 20px;
    location: center;
}

mainbox {
    background-color: transparent;
    spacing: 15px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    background-color: @background-alt;
    border-radius: 12px;
    padding: 12px;
    children: [ "prompt" ];
    justify-content: center;
}

prompt {
    background-color: transparent;
    text-color: @selected;
    font: "JetBrainsMono Nerd Font Bold 12";
    padding: 5px;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 5;
    spacing: 10px;
    cycle: true;
    dynamic: true;
    layout: vertical;
}

element {
    background-color: transparent;
    text-color: @foreground;
    border-radius: 12px;
    padding: 15px;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @selected;
    text-color: @background;
}

element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    font: "JetBrainsMono Nerd Font 14";
    horizontal-align: 0.5;
    vertical-align: 0.5;
    cursor: inherit;
}
