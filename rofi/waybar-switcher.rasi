configuration {
    show-icons:         false;
    click-to-exit:      true;
    hover-select:       true;       
    me-select-entry:    "MousePrimary";
    me-accept-entry:    "!MousePrimary";
}

@import "~/.config/rofi/colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 12";
    
    bg:      @background;
    bg-alt:  @background-alt;
    fg:      @foreground;
    accent:  @selected;
    
    background-color: transparent;
    text-color:       @fg;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    16px;
    width:            450px;
    location:         center;
    anchor:           center;
    padding:          20px; 
}

mainbox {
    spacing: 15px;
}

inputbar {
    background-color: @bg-alt;
    border-radius:    12px;
    padding:          15px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder:       "Search layouts...";
    placeholder-color: @fg;
    text-color:        @fg;
    cursor:            text;
}

listview {
    columns:          1;
    lines:            6;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    spacing:          8px;
}

element {
    padding:          12px 15px;
    border-radius:    8px;
    cursor:           pointer;
}

element-text {
    cursor:           inherit;
    vertical-align:   0.5;
    font:             "JetBrainsMono Nerd Font 11";
    text-color:       inherit;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg;
}
